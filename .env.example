# ---------------------------------------------------------------------------
# Contact form (EnvelopeFooter) - Resend + optional reCAPTCHA
#
# Copy this file to `.env` for local dev, and set the same variables in the
# Cloudflare Pages project (Settings -> Variables and Secrets) for deploys.
#
# IMPORTANT: every VITE_* variable is inlined into the public JS bundle at
# build time. Anything here is readable by anyone who opens devtools. Resend
# credentials must never use the VITE_ prefix.
# ---------------------------------------------------------------------------

# Server-only Resend API key. Set this as a Cloudflare secret.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Resend requires a verified sender/domain for production mail.
CONTACT_FROM_EMAIL="ACM-W VIT <contact@example.com>"

# Defaults to acm@vit.ac.in if omitted.
CONTACT_TO_EMAIL=acm@vit.ac.in

# Optional subject prefix.
CONTACT_SUBJECT_PREFIX="ACM-W VIT Contact"

# Google reCAPTCHA v2 **Invisible** site key (https://www.google.com/recaptcha/admin)
#
# Invisible rather than the "I'm not a robot" checkbox: the form lives on a
# card inside a 3D-transformed, scroll-animated envelope, and an inline
# reCAPTCHA iframe would be scaled and mispositioned by that transform.
VITE_RECAPTCHA_SITE_KEY=6Lxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Matching server-only secret key. If omitted, the contact API skips reCAPTCHA
# verification. Set this as a Cloudflare secret when enabling the site key.
RECAPTCHA_SECRET_KEY=6Lxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
