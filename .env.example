# ---------------------------------------------------------------------------
# Contact form (EnvelopeFooter) — EmailJS + reCAPTCHA
#
# Copy this file to `.env` for local dev, and set the same variables in the
# Cloudflare Pages project (Settings -> Environment variables) for deploys.
#
# IMPORTANT: every VITE_* variable is inlined into the public JS bundle at
# build time. Anything here is readable by anyone who opens devtools. That is
# expected for these values — none of them are secrets. The two real secrets,
# the EmailJS Private Key and the reCAPTCHA Secret Key, live ONLY in the
# EmailJS dashboard and must never be added to this file.
# ---------------------------------------------------------------------------

# EmailJS -> Email Services -> your service ID (looks like service_xxxxxxx)
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx

# EmailJS -> Email Templates -> your template ID (looks like template_xxxxxxx)
#
# The template's "To Email" field must be hardcoded to the ACM VIT address:
#   outreach.acmvit@gmail.com
# Do NOT set it to {{to_email}} — the recipient must not be controllable from
# the browser, or anyone could relay mail through this account. The app
# deliberately does not send a recipient parameter.
#
# The template should reference these variables, which the form does send:
#   {{from_name}}  {{from_email}}  {{phone}}  {{message}}
# Set "Reply To" to {{from_email}} so replies go back to the sender.
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx

# EmailJS -> Account -> General -> Public Key
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxx

# Google reCAPTCHA v2 **Invisible** site key (https://www.google.com/recaptcha/admin)
#
# Invisible rather than the "I'm not a robot" checkbox: the form lives on a
# card inside a 3D-transformed, scroll-animated envelope, and an inline
# reCAPTCHA iframe would be scaled and mispositioned by that transform.
#
# The matching Secret Key goes in the EmailJS template settings
# (Template -> Settings -> Enable reCAPTCHA verification), never here.
# If this is left unset the form still submits, but EmailJS will reject the
# send once reCAPTCHA is enabled on the template.
VITE_RECAPTCHA_SITE_KEY=6Lxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
